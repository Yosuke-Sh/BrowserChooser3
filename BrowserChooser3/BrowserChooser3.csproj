<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\BrowserChooser2.ico</ApplicationIcon>
    <DocumentationFile>BrowserChooser3.xml</DocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- リリースビルドでPDBファイルを除外 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- インストーラー配布物用のReadyToRun設定（dotnet publish時のみ有効。dotnet buildの出力構成には影響しない） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- PDBファイルを明示的に除外 -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Remove="**/*.pdb" />
    <Content Remove="**/*.pdb" />
    <EmbeddedResource Remove="**/*.pdb" />
  </ItemGroup>

  <!-- ビルド後のPDBファイル削除 -->
  <Target Name="RemovePdbFiles" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PdbFiles Include="$(OutputPath)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbFiles)" ContinueOnError="true" />
    <Message Text="PDBファイルを削除しました: @(PdbFiles)" Importance="high" />
  </Target>

  <!-- テストプロジェクトからinternalメンバー（テスト専用シーム等）を参照可能にする -->
  <ItemGroup>
    <InternalsVisibleTo Include="BrowserChooser3.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.ico" />
    <EmbeddedResource Include="Resources\*.png" />
    <EmbeddedResource Include="Resources\*.xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>